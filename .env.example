# ─── Database ──────────────────────────────────────────────────────────
# SQLite for local dev. For production, swap to Postgres/MySQL and update
# the datasource provider in prisma/schema.prisma + prisma.config.ts.
DATABASE_URL=file:./prisma/dev.db

# ─── NextAuth ──────────────────────────────────────────────────────────
NEXTAUTH_URL=http://localhost:3000
# Generate with: openssl rand -base64 32
NEXTAUTH_SECRET=

# Public base URL used when constructing OAuth redirect URIs (Gmail/Outlook).
# Set this to your deployed URL in production (e.g. https://app.example.com).
APP_BASE_URL=http://localhost:3000

# ─── Encryption (stored OAuth tokens, IMAP passwords) ──────────────────
# Generate with: openssl rand -base64 32
# Falls back to NEXTAUTH_SECRET if unset, but set it explicitly in prod.
ENCRYPTION_KEY=

# ─── AI Provider keys ──────────────────────────────────────────────────
# At least one of these is required for scans to work.
# Resolution order: user's saved key → GEMINI_API_KEY → ANTHROPIC_API_KEY → OPENAI_API_KEY
#
# Gemini free tier (recommended default): get a key at https://aistudio.google.com/apikey
GEMINI_API_KEY=
# Anthropic (Claude Sonnet): get a key at https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=
# OpenAI (GPT-4o mini): get a key at https://platform.openai.com/api-keys
OPENAI_API_KEY=

# ─── Google OAuth (Gmail + Calendar) ───────────────────────────────────
# Create at https://console.cloud.google.com/apis/credentials
# Scopes needed: gmail.readonly, calendar.readonly, openid, email, profile
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ─── Microsoft OAuth (Outlook + Calendar) ──────────────────────────────
# Create at https://portal.azure.com → App registrations
# Scopes: Mail.Read, Calendars.Read, offline_access, openid, email, profile
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=

# ─── Cron jobs (digest, push notifications, auto follow-up) ────────────
# Vercel Cron injects this automatically as Authorization: Bearer <value>
# For self-hosted/GitHub Actions, send as x-cron-secret header.
# Generate with: openssl rand -hex 32
CRON_SECRET=

# ─── Web Push (PWA notifications) ──────────────────────────────────────
# Generate both with: npx web-push generate-vapid-keys
VAPID_SUBJECT=mailto:you@yourdomain.com
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=

# ─── Plan override (early access) ───────────────────────────────────────
# Set to "pro" to put every user on the Pro plan with no expiry — used
# during early access while billing isn't wired yet.  Remove or set to
# "free" once billing is live.  Values: free | lite | pro
PROMO_PLAN=pro
