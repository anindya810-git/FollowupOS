generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model User {
  id                   String    @id @default(cuid())
  name                 String?
  email                String    @unique
  emailVerified        DateTime?
  image                String?
  customImage          String?
  timezone             String    @default("Asia/Kolkata")
  designation          String?
  company              String?
  phone                String?
  socialLinkedin       String?
  socialTwitter        String?
  socialInstagram      String?
  socialFacebook       String?
  socialSnapchat       String?
  onboardingCompleted  Boolean   @default(false)
  anthropicApiKeyEncrypted String?
  openaiApiKeyEncrypted    String?
  geminiApiKeyEncrypted    String?
  preferredAiProvider      String?
  zoomAccessTokenEncrypted  String?
  zoomRefreshTokenEncrypted String?
  zoomTokenExpiresAt        DateTime?
  zoomAccountEmail          String?
  // Billing / plan
  referralCode     String    @unique @default(cuid())
  planType         String    @default("free")   // free | lite | pro
  planExpiresAt    DateTime?                     // null = never (paid + managed externally)
  trialStartedAt   DateTime  @default(now())
  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt

  accounts       Account[]
  sessions       Session[]
  emailAccounts  EmailAccount[]
  emailThreads   EmailThread[]
  emailMessages  EmailMessage[]
  actionItems    ActionItem[]
  aiLogs         AiClassificationLog[]
  userFeedback   UserFeedback[]
  ignoredSenders IgnoredSender[]
  watchList      WatchList[]
  digestSettings DigestSettings?
  appSettings    AppSettings?
  contacts       Contact[]
  pushSubscriptions PushSubscription[]
  scheduledMessages ScheduledMessage[]
  referralsGiven    Referral[]   @relation("ReferralsGiven")
  referralReceived  Referral?    @relation("ReferralReceived")
  shareEvents       ShareEvent[]
  payments          Payment[]
}

model ScheduledMessage {
  id            String   @id @default(cuid())
  userId        String
  actionItemId  String?
  emailAccountId String
  toEmail       String
  subject       String
  contentHtml   String
  scheduledFor  DateTime
  status        String   @default("pending") // pending | sent | failed | cancelled
  sentAt        DateTime?
  errorMessage  String?
  threadId       String?  // providerThreadId for in-reply-to
  lastMessageId  String?  // providerMessageId of message being replied to
  lastRfcMessageId String? // RFC Message-ID header, for SMTP In-Reply-To threading
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([status, scheduledFor])
}

model PushSubscription {
  id        String   @id @default(cuid())
  userId    String
  endpoint  String   @unique
  p256dh    String
  auth      String
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model EmailAccount {
  id                    String    @id @default(cuid())
  userId                String
  provider              String    @default("gmail")
  emailAddress          String
  accessTokenEncrypted  String?
  refreshTokenEncrypted String?
  tokenExpiresAt        DateTime?
  connectedStatus       String    @default("connected")
  imapHost              String?
  imapPort              Int?
  passwordEncrypted     String?
  webmailBaseUrl        String?
  webmailSearchUrlTemplate String?
  lastSyncedAt          DateTime?
  initialScanCompleted  Boolean   @default(false)
  gmailHistoryId        String?
  // Per-inbox overrides. null = inherit the account-wide AppSettings value.
  // noiseFilterLevel overrides the global level for this inbox only.
  noiseFilterLevel      Int?
  // scanInstructions is appended to the global "Teach Pendingly" instructions
  // for this inbox only (additive, not a replacement).
  scanInstructions      String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  user         User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  emailThreads EmailThread[]

  @@unique([userId, emailAddress])
}

model EmailThread {
  id                  String    @id @default(cuid())
  userId              String
  emailAccountId      String
  provider            String    @default("gmail")
  providerThreadId    String
  subject             String?
  participants        String?
  lastMessageAt       DateTime?
  lastMessageFromUser Boolean   @default(false)
  providerUrl         String?
  threadHash          String?
  isNoise             Boolean   @default(false)
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt

  user         User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  emailAccount EmailAccount   @relation(fields: [emailAccountId], references: [id], onDelete: Cascade)
  messages     EmailMessage[]
  actionItems  ActionItem[]
  aiLogs       AiClassificationLog[]

  @@unique([emailAccountId, providerThreadId])
}

model EmailMessage {
  id                String    @id @default(cuid())
  userId            String
  emailThreadId     String
  providerMessageId String
  rfcMessageId      String?
  senderEmail       String?
  senderName        String?
  recipients        String?
  cc                String?
  sentAt            DateTime?
  snippet           String?
  bodyExcerpt       String?
  bodyHash          String?
  isFromUser        Boolean   @default(false)
  labels            String?
  // JSON array of {url, text} extracted from the message HTML at scan time.
  // Capped at ~20 entries to keep row size sane.
  linksJson         String?
  // JSON array of {filename, mimeType, sizeBytes, attachmentId} for attachments.
  // attachmentId is the provider-specific ID (Gmail attachment ID, Outlook
  // attachment id). null for IMAP where we only learn name + size.
  attachmentsJson   String?
  createdAt         DateTime  @default(now())

  user        User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  emailThread EmailThread @relation(fields: [emailThreadId], references: [id], onDelete: Cascade)

  @@unique([emailThreadId, providerMessageId])
}

model ActionItem {
  id              String    @id @default(cuid())
  userId          String
  emailThreadId   String?
  source          String    @default("gmail")
  category        String
  status          String    @default("open")
  priority        String    @default("medium")
  title           String?
  reason          String?
  suggestedAction String?
  dueDate         String?
  ownerType       String?
  ownerName       String?
  ownerEmail      String?
  confidenceScore Float?
  lastActivityAt  DateTime?
  snoozedUntil    String?
  completedAt     DateTime?
  ignoredReason   String?
  lastAutoFollowupAt  DateTime?
  repeatedAskCount    Int       @default(0)
  needsClosure        Boolean   @default(false)
  autoReplySuggestion String?
  // Provider-side calendar event / task IDs (set when user creates one via
  // "Add to calendar" or via auto-create). Lets us link, update, delete.
  calendarEventId      String?
  calendarEventProvider String?  // google | outlook
  calendarTaskId       String?
  calendarTaskProvider String?  // google | outlook
  // Which step of the followup sequence has been sent (0-indexed). 0 = none.
  followupStep         Int       @default(0)
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  user        User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  emailThread EmailThread? @relation(fields: [emailThreadId], references: [id], onDelete: Cascade)
  feedback    UserFeedback[]
}

model AiClassificationLog {
  id              String   @id @default(cuid())
  userId          String
  emailThreadId   String?
  modelProvider   String?
  modelName       String?
  inputHash       String?
  outputJson      String?
  confidenceScore Float?
  errorMessage    String?
  // True when the request used Pendingly's default API key (so it counts
  // against the user's plan quota).  False for BYOK calls — those are
  // billed to the user's own provider account and aren't metered.
  usedDefaultKey  Boolean  @default(false)
  // Kind of call (classify | draft | suggest) so usage UI can break down by type
  callType        String   @default("classify")
  createdAt       DateTime @default(now())

  user        User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  emailThread EmailThread? @relation(fields: [emailThreadId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
}

model UserFeedback {
  id            String   @id @default(cuid())
  userId        String
  actionItemId  String?
  feedbackType  String
  feedbackValue String?
  createdAt     DateTime @default(now())

  user       User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  actionItem ActionItem? @relation(fields: [actionItemId], references: [id], onDelete: Cascade)
}

model IgnoredSender {
  id          String   @id @default(cuid())
  userId      String
  senderEmail String?
  domain      String?
  reason      String?
  createdAt   DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

// A WatchList entry tells Pendingly to push-notify the user on any NEW inbound
// mail matching it — independent of urgency classification. An entry targets
// exactly one of: a specific thread (threadId = providerThreadId), a person
// (senderEmail), or a whole domain.
model WatchList {
  id          String   @id @default(cuid())
  userId      String
  senderEmail String?
  domain      String?
  threadId    String?  // providerThreadId of a specific thread
  label       String?  // friendly label for the UI (contact name / subject)
  createdAt   DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

// De-dupes watchlist push notifications: one row per message we've already
// notified about, so re-scans of the same thread never re-notify.
model WatchNotification {
  id                String   @id @default(cuid())
  userId            String
  providerMessageId String
  createdAt         DateTime @default(now())

  @@unique([userId, providerMessageId])
}

model DigestSettings {
  id                String   @id @default(cuid())
  userId            String   @unique
  isEnabled         Boolean  @default(true)
  digestTime        String   @default("09:00")
  timezone          String   @default("Asia/Kolkata")
  slackWebhookUrl   String?
  slackEnabled      Boolean  @default(false)
  teamsWebhookUrl   String?
  teamsEnabled      Boolean  @default(false)
  whatsappEnabled   Boolean  @default(false)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model AppSettings {
  id                  String   @id @default(cuid())
  userId              String   @unique
  defaultFollowupDays Int      @default(3)
  scanWindowDays      Int      @default(30)
  conservativeMode    Boolean  @default(true)
  autoFollowupEnabled  Boolean @default(false)
  autoFollowupDays     Int     @default(3)
  autoFollowupTemplate String?
  // JSON array of {dayOffset, tone, template, sent} — when set and non-empty,
  // overrides single-step autoFollowupDays/Template.
  followupSequenceJson String?
  signatureHtml        String?
  // Calendar integration: off | event | task | both. When not 'off',
  // creating an action item also creates a calendar event and/or task
  // on the source provider (Google or Outlook).
  calendarAutoCreate     String  @default("off")
  // Default conferencing provider for manual event creation:
  // none | meet | teams | zoom
  defaultMeetingProvider String  @default("none")
  // Web push reminder when a snoozed item wakes
  reminderPushEnabled    Boolean @default(true)
  // Email footer: "Sent via Pendingly". Free users always have it on.
  emailSignatureEnabled  Boolean @default(true)
  // 1=Minimal … 5=Maximum. Controls how aggressively emails are pre-filtered
  // before reaching AI classification. Default 3 (Balanced).
  noiseFilterLevel       Int     @default(3)
  // User-supplied free-text instructions injected into AI classification prompt.
  scanInstructions       String?
  // "Pause everything" / vacation mode. When true, all automation (auto
  // follow-ups, scheduled sends, snooze wake-ups, digests, nudges) is held.
  automationPaused       Boolean @default(false)
  // JSON array of installed connector keys, e.g. ["google_calendar","google_meet"].
  // A connector being "available" (its underlying account is synced) is distinct
  // from it being installed/enabled here. Only installed connectors surface as
  // options when creating calendar events / meetings from action items.
  enabledConnectors      String?
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model ScanJob {
  id                 String   @id @default(cuid())
  userId             String
  emailAccountId     String
  status             String   @default("queued")
  threadsFound       Int      @default(0)
  threadsProcessed   Int      @default(0)
  actionItemsCreated Int      @default(0)
  errorMessage       String?
  debugLog           String?
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt
}

model Contact {
  id        String   @id @default(cuid())
  userId    String
  email     String
  name      String?
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, email])
}

// One record per referral conversion. referredUserId is @unique so a user
// can only be credited as "referred" once.
model Referral {
  id             String    @id @default(cuid())
  referrerId     String
  referredUserId String    @unique
  daysAwarded    Int       @default(30)
  createdAt      DateTime  @default(now())

  referrer User @relation("ReferralsGiven",  fields: [referrerId],     references: [id], onDelete: Cascade)
  referred User @relation("ReferralReceived", fields: [referredUserId], references: [id], onDelete: Cascade)

  @@index([referrerId])
}

// One record per share event. Limited to one per user per day in the API
// so users can't game 7-day bonuses endlessly.
model ShareEvent {
  id        String   @id @default(cuid())
  userId    String
  platform  String?
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

// Payment records for Stripe and Razorpay transactions.
model Payment {
  id                    String   @id @default(cuid())
  userId                String
  amountCents           Int      // amount in smallest currency unit (paise for INR, cents for USD)
  currency              String   @default("INR")
  provider              String   // stripe | razorpay
  status                String   @default("pending") // pending | captured | failed | refunded
  stripePaymentIntentId String?
  razorpayOrderId       String?
  razorpayPaymentId     String?
  planType              String   // lite | pro
  planDays              Int      @default(30)
  notes                 String?
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([createdAt])
}

// Singleton row for admin-managed gateway credentials.
model AdminConfig {
  id                       String   @id @default("singleton")
  stripeSecretKeyEncrypted  String?
  stripePublishableKey      String?  // publishable key is not secret
  razorpayKeyIdEncrypted    String?
  razorpaySecretEncrypted   String?
  updatedAt                 DateTime @updatedAt
}
